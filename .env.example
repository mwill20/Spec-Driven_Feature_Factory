# URL Shortener Service — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Database connection URL
# SQLite (default, no setup required):
DATABASE_URL=sqlite:///./url_shortener.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/url_shortener

# Base URL used to construct short URLs in API responses
# Change to your production domain before deploying
BASE_URL=http://localhost:8000

# Comma-separated list of additional blocked domains (appended to the default list)
# Example: BLOCKED_DOMAINS=badsite.com,anotherbad.net
BLOCKED_DOMAINS=
